{
  "name": "kerygma-yt-downloader",
  "productName": "Kerygma YT Downloader",
  "version": "1.0.0",
  "description": "Descarga videos de YouTube con audio o solo el audio, en el formato y la calidad que elijas. Para Windows y macOS; hermano de Kerygma Converter.",
  "main": "main.js",
  "author": "Kerygma",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fetch-bins": "node scripts/fetch-binaries.js",
    "icon": "electron scripts/make-icon.js",
    "screenshot": "electron scripts/screenshot.js",
    "test": "node scripts/smoke-test.js",
    "dist:mac": "node scripts/fetch-binaries.js mac-x64 mac-arm64 && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "node scripts/fetch-binaries.js win-x64 && electron-builder --win --x64 --publish never",
    "dist": "npm run dist:mac && npm run dist:win"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.kerygma.ytdownloader",
    "productName": "Kerygma YT Downloader",
    "copyright": "Kerygma",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/${os}-${arch}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Kerygma-YT-Downloader-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon-mac.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Kerygma-YT-Downloader-${version}-Windows-Portable.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "dmg": {
      "title": "Kerygma YT Downloader",
      "artifactName": "Kerygma-YT-Downloader-${version}-Mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "menuCategory": "Kerygma YT Downloader",
      "shortcutName": "Kerygma YT Downloader",
      "uninstallDisplayName": "Kerygma YT Downloader",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "artifactName": "Kerygma-YT-Downloader-${version}-Windows-Instalador.${ext}"
    }
  }
}
